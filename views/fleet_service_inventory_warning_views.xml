<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_service_inventory_warning_form" model="ir.ui.view">
        <field name="name">fleet.service.inventory.warning.form</field>
        <field name="model">fleet.service.inventory.warning</field>
        <field name="arch" type="xml">
            <form string="Advertencia de Inventario">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>¡Atención!</strong> Se han detectado problemas de disponibilidad en el inventario.
                    </div>
                    <group>
                        <field name="message" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Continuar de todos modos" type="object" name="action_continue" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
