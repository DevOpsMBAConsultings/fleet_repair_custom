<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_log_services_view_form_inherit_repair" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.form.inherit.repair</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="replace">
                <header>
                    <button name="action_waiting" string="Poner en Espera" type="object" class="oe_highlight" attrs="{'invisible': [('state', 'not in', ['draft', 'in_progress'])]}"/>
                    <button name="action_in_progress" string="Iniciar Servicio" type="object" class="oe_highlight" attrs="{'invisible': [('state', 'not in', ['draft', 'waiting'])]}"/>
                    <button name="action_done" string="Finalizar Servicio" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'in_progress')]}"/>
                    <button name="action_cancel" string="Cancelar" type="object" attrs="{'invisible': [('state', 'in', ['done', 'cancelled'])]}"/>
                    <button name="action_draft" string="Volver a Borrador" type="object" attrs="{'invisible': [('state', '!=', 'cancelled')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting,in_progress,done"/>
                </header>
            </xpath>
            <xpath expr="//sheet/group[1]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_picking" type="object" class="oe_stat_button" icon="fa-cubes" attrs="{'invisible': [('picking_id', '=', False)]}">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Inventario</span>
                        </div>
                    </button>
                </div>
            </xpath>
            <xpath expr="//sheet/group" position="after">
                <notebook>
                    <page string="Repuestos / Insumos" name="parts">
                        <field name="part_line_ids" attrs="{'readonly': [('state', 'in', ['done', 'cancelled'])]}">
                            <tree editable="bottom">
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="uom_id"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Informe de Mantenimiento" name="maintenance_report">
                        <group>
                            <field name="antecedentes_servicio"/>
                            <field name="hallazgos"/>
                            <field name="accion_correctiva"/>
                            <field name="recomendaciones"/>
                        </group>
                    </page>
                    <page string="Evidencias Fotográficas" name="images">
                        <p class="text-muted">Puedes agregar hasta 15 imágenes por orden de servicio.</p>
                        <field name="image_ids" mode="kanban">
                            <kanban>
                                <field name="id"/>
                                <field name="image"/>
                                <field name="description"/>
                                <templates>
                                    <t t-name="kanban-box">
                                        <div class="oe_kanban_global_click">
                                            <div class="o_kanban_image">
                                                <img t-att-src="kanban_image('fleet.service.image', 'image', record.id.raw_value)" alt="Imagen"/>
                                            </div>
                                            <div class="oe_kanban_details">
                                                <div class="o_kanban_record_title">
                                                    <strong><field name="description"/></strong>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                            <form>
                                <sheet>
                                    <div class="row">
                                        <field name="id" invisible="1"/>
                                        <div class="col-4 d-flex flex-column align-items-center">
                                            <field name="image" widget="image" options="{'size': [128, 128]}"/>
                                            <button name="action_download" type="object" icon="fa-download" string=" Descargar" class="btn-secondary btn-sm mt-3" attrs="{'invisible': ['|', ('id', '=', False), ('image', '=', False)]}"/>
                                        </div>
                                        <div class="col-8">
                                            <group>
                                                <field name="description" placeholder="Añade una descripción..."/>
                                            </group>
                                        </div>
                                    </div>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </notebook>
            </xpath>
            <xpath expr="//field[@name='vendor_id']" position="after">
                <field name="picking_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
