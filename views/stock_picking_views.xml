<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock_picking_view_form_inherit_fleet" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit.fleet</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <!-- Agregar el campo debajo del documento de origen -->
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="fleet_service_id" attrs="{'invisible': [('fleet_service_id', '=', False)]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
